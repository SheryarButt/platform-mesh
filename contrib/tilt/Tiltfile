# Platform Mesh — Tilt local development environment.
#
# See contrib/adr/adr-02-tilt-local-dev-environment.md for the full design.
#
# kcp is BUILT, not installed. The base environment runs platform-mesh-deployer
# and gives it a PlatformMesh; the deployer compiles that into the kcp-operator
# admin CRs and reconciles them itself, and kcp appears. There is no static
# install and no `deployer` profile — the deployer IS the infrastructure, so
# every profile sits on the kcp it produced.
#
# Quick start:
#   kind create cluster --name platform-mesh
#   tilt up -f contrib/tilt/Tiltfile
#
# Render-only (no cluster, no remote fetches) for validating manifests:
#   TILT_NO_INFRA=1 tilt alpha tiltfile-result -f contrib/tilt/Tiltfile

# ---------------------------------------------------------------------------
# config
# ---------------------------------------------------------------------------

# Profiles map onto RFC 008 shapes (see ADR). `infra` builds kcp; the others add
# feature layers on top of it.
#
# Profiles COMPOSE: they are independent feature layers, not an ordered ladder, so
# several can be requested at once and each one only ever adds resources.
#
#   --profile=core,auth         (or --profile=core --profile=auth)
#   --profile=full              shorthand for every profile below
#
# `infra` is always on — the base environment (namespace, issuer, gateway, etcd,
# dex, the deployer and the kcp it builds) is unconditional — so naming it is
# allowed but redundant.
PROFILES_ALL = ['infra', 'core', 'auth']
config.define_string_list('profile', args=False, usage='comma-separated: {}|full (default: infra)'.format('|'.join(PROFILES_ALL)))
cfg = config.parse()

# Tilt's string_list accumulates repeated flags but does NOT split on commas, so
# do it here — both spellings above then work, and `--profile=core,auth` is the
# one people reach for first.
PROFILES = []
for _arg in cfg.get('profile', ['infra']):
    for _p in _arg.split(','):
        _p = _p.strip()
        if _p and _p not in PROFILES:
            PROFILES.append(_p)

if 'full' in PROFILES:
    PROFILES = PROFILES_ALL
for _p in PROFILES:
    if _p not in PROFILES_ALL:
        fail('unknown profile {!r}: expected one or more of {} (or "full")'.format(_p, ', '.join(PROFILES_ALL)))

def profile(name):
    """True when `name` was requested (directly or via `full`)."""
    return name in PROFILES

NAMESPACE = 'platform-mesh-system'

# ADDRESSING — every hostname in this environment is `<name>.<CLUSTER_ID>.sslip.io`
# reached on GATEWAY_NODEPORT.
#
# One scheme, because a kcp hostname has to resolve to the SAME address from
# three places: the host, the kcp shards, and anything following an
# APIExportEndpointSlice URL (which is dialed verbatim and cannot be rewritten by
# a kubeconfig). sslip.io resolves `root.192-168-0-2.sslip.io` to 192.168.0.2 for
# all of them, so there are NO hostAliases anywhere in this environment and no
# "advertised but not routed" gateway address to reconcile.
#
# It must be the NodePort and not the gateway's own listener port: sslip.io
# resolves to the node, and nothing listens on node:8443.
#
# Defined here rather than in the deployer's Tiltfile because dex needs the same
# two values, and dex is configured before kcp exists.
CLUSTER_ID = os.getenv('DEPLOYER_CLUSTER_ID', '') or (str(local(
    'kubectl get nodes -o jsonpath=' +
    "'{.items[0].status.addresses[?(@.type==\"InternalIP\")].address}'" +
    ' 2>/dev/null || true',
    quiet=True, echo_off=True)).strip().replace('.', '-') or '127-0-0-1')
GATEWAY_NODEPORT = 31443

def sslip(name):
    """`<name>.<cluster>.sslip.io` — the one way anything is addressed here."""
    return '{}.{}.sslip.io'.format(name, CLUSTER_ID)

# The OIDC settings, defined ONCE and read by both kcp's authenticator (through
# the RootShardTemplate's spec.auth.oidc) and dex's own configuration.
#
# One dict is the enforcement: dex issues the tokens kcp verifies, so an issuer
# URL, client ID or claim mapping that drifts between the two is a token kcp
# rejects for reasons nothing useful logs.
KCP_OIDC = {
    'issuerURL': 'https://{}:{}'.format(sslip('idp'), GATEWAY_NODEPORT),
    'clientID': 'platform-mesh',
    'groupsClaim': 'groups',
    'usernameClaim': 'email',
    # Set deliberately, for `email` too.
    #
    # kube only auto-prefixes when the claim is not `email`, so an email claim
    # with no prefix puts OIDC usernames in the SAME namespace as every other
    # authenticator — ServiceAccounts, kcp's own kcp-admin, anything under
    # system:. A prefix keeps them apart and makes an RBAC subject say where the
    # identity came from.
    #
    # Anything writing RBAC for an OIDC user has to MIRROR this: a binding whose
    # subject omits the prefix names an identity that never authenticates, and the
    # user is 403'd by a binding that looks correct. Keeping the prefix here rather
    # than in each component's chart is what stops that drift.
    'usernamePrefix': 'pm:',
    # Set for the same reason usernamePrefix is, plus one that is sharper for
    # groups: an unprefixed group claim puts whatever the IdP says straight into
    # kcp's own group namespace, so an issuer that hands someone `system:masters`
    # hands them what that name MEANS. The prefix makes that impossible to say.
    #
    # It must be written down rather than left out: kcp defaults an unset
    # groupsPrefix to `oidc:`, so omitting it here would not mean "no prefix", it
    # would mean "a prefix nothing else in the environment was told about".
    'groupsPrefix': 'pm:',
    'caFileRef': {'name': 'dex-ca', 'key': 'ca.crt'},
}

# NOT DEFINED HERE ANY MORE: an in-cluster override for kcp's address.
#
# It existed because *.pm.localhost resolved to loopback inside a pod, so every
# client needed to be redirected at the front-proxy Service instead. Under
# sslip.io the address kcp publishes in its own kubeconfigs already resolves and
# routes from inside the cluster, so clients use it verbatim and the override,
# the hostAliases and the "which of the two mechanisms covers this traffic?"
# question all go away.

# Skip remote-fetch infra (cert-manager, envoy gateway, the kcp-operator CRDs) so
# the Tiltfile evaluates offline — used for manifest validation. Local manifests
# and the kcp CRs still render.
NO_INFRA = os.getenv('TILT_NO_INFRA', '') not in ('', '0', 'false', 'no')

print('Platform Mesh dev env — profiles={} no_infra={}'.format(','.join(PROFILES), NO_INFRA))

# ---------------------------------------------------------------------------
# context guard
# ---------------------------------------------------------------------------

# Refuse to deploy anywhere except the dedicated kind cluster. kind names its
# context "kind-<clustername>", so the cluster from
#   kind create cluster --name platform-mesh
# is reached via context "kind-platform-mesh". This prevents an accidental
# `tilt up` from applying to whatever kubeconfig context happens to be current
# (a shared dev/staging cluster, another kind, docker-desktop, ...).
#
# Only enforced for real deploys (up/ci); `tilt alpha tiltfile-result` and other
# subcommands evaluate without a cluster and are left alone. Override the target
# with TILT_ALLOWED_CONTEXT if you named your cluster differently.
ALLOWED_CONTEXT = os.getenv('TILT_ALLOWED_CONTEXT', 'kind-platform-mesh')
allow_k8s_contexts(ALLOWED_CONTEXT)
if config.tilt_subcommand in ('up', 'ci'):
    _ctx = k8s_context()
    if _ctx != ALLOWED_CONTEXT:
        fail(
            'refusing to run against kube context {!r}: this Tiltfile only targets {!r}.\n'.format(_ctx, ALLOWED_CONTEXT) +
            'Create/select it with:\n' +
            '  kind create cluster --name platform-mesh\n' +
            '  kubectl config use-context {}\n'.format(ALLOWED_CONTEXT) +
            '(or set TILT_ALLOWED_CONTEXT to override).'
        )

# ---------------------------------------------------------------------------
# static infra owned by THIS project
# ---------------------------------------------------------------------------

# Local manifests (no remote fetch): system namespace, self-signed issuer, the
# envoy Gateway the kcp routes attach to, and a dev etcd for the shards.
#
# The namespace is its own resource with NO CRD-dependent siblings, so it always
# applies immediately. Everything scoped to platform-mesh-system waits on it
# (resource_deps) — otherwise a resource bundled with the namespace that fails to
# apply (e.g. the Issuer before cert-manager's CRD exists) would strand the
# namespace and every namespaced resource would fail with "namespace not found".
k8s_yaml('manifests/namespace.yaml')
k8s_resource(
    new_name='namespace',
    objects=['platform-mesh-system:namespace'],
    labels=['infra'],
)

# Issuer depends on the namespace; it also needs cert-manager's CRD, so Tilt
# retries it until cert-manager (infra_remote) is up.
k8s_yaml('manifests/issuer.yaml')
k8s_resource(
    new_name='cert-issuer',
    objects=['selfsigned:issuer'],
    labels=['infra'],
    resource_deps=['namespace'],
)

# Every front-proxy path this environment claims, accumulated per profile.
#
# Built here, above the deployer, because the FrontProxyTemplate is rendered with
# the PlatformMesh — the front proxy is compiled from it, and a profile enabled
# further down cannot add a path afterwards. A component installed by Helm (as
# opposed to by an OCMModule, which declares its own `mapping`) appends an entry
# here as {'path': ..., 'backend': ...}; a chart cannot register the path itself,
# because the deployer owns spec.additionalPathMappings and applies it with
# ForceOwnership.
#
# Append, do not reassign: a second profile wanting a path adds a line, and the
# deployer settles precedence and collisions over these AND every module's
# mapping together (mergePathMappings). Two owners claiming one path is an error
# there rather than a route that silently shadows another.
FRONT_PROXY_MAPPINGS = []

# The gateway is NOT defined here. The single `eg` gateway comes from the
# deployer's config/bases/envoy-gateway, together with the NodePort that makes
# the sslip.io names reachable. One gateway on purpose: kcp and dex hang
# TLSRoutes off the same listener, and a second one only meant a second place for
# a route to silently fail to attach.

# NO PLAINTEXT etcd HERE ANY MORE either. The deployer brings a mutual-TLS etcd
# reachable through the gateway, because a shard it places on another cluster
# resolves the endpoint verbatim and a .svc name means nothing there.

# Dex — the OIDC issuer kcp authenticates against (RootShard spec.auth.oidc).
# kcp always needs an issuer wired, and the deployer won't create the shard
# Deployment until the referenced CA secret (dex-ca) exists, so Dex ships in the
# base environment. Terminates its own TLS and is routed by SNI through the
# passthrough gateway; the cert chain publishes `dex-ca`.
#
# Substituted rather than read straight off disk: the issuer URL, the serving
# certificate's SAN and the TLSRoute hostname all carry the cluster ID, and the
# shards verify tokens against that exact URL. See the header in the manifest.
k8s_yaml(blob(str(read_file('manifests/dex.yaml'))
              .replace('__CLUSTER__', CLUSTER_ID)
              .replace('__PORT__', str(GATEWAY_NODEPORT))))
k8s_resource(
    'dex',
    objects=[
        'dex-ca:certificate',
        'dex-ca:issuer',
        'dex-server:certificate',
        'dex:configmap',
        'dex:tlsroute',
    ],
    labels=['infra'],
    resource_deps=['namespace', 'cert-issuer'],
)

# Remote-fetch infra (cert-manager, envoy gateway controller, Flux, OCM).
#
# No kcp-operator here, and none anywhere: the deployer runs its controller
# groups in its own process and installs only its CRDs.
if not NO_INFRA:
    include('./infra_remote.Tiltfile')

# ---------------------------------------------------------------------------
# kcp — BUILT by platform-mesh-deployer, not installed
# ---------------------------------------------------------------------------

# The wiring lives with the component, at operators/platform-mesh-deployer/
# Tiltfile, next to the kustomizations it deploys. This file only supplies what
# is environment-wide.
#
# This is the base environment, not an option: the deployer, the kcp-operator
# CRDs it reconciles, a mutual-TLS etcd, the `eg` gateway, the CoreDNS sslip.io
# answers, and a PlatformMesh for it to compile into kcp. Everything else in
# this file sits on the kcp that comes out.
#
# There is exactly one way to get a kcp here, on purpose. A second one would
# have to own the same shards and the same operator.kcp.io CRDs, and every
# component would then have to work against both.
load('./helpers.py', 'component_build', 'component_binary')

deploy_deployer = load_dynamic('../../operators/platform-mesh-deployer/Tiltfile')['deploy_deployer']
deploy_deployer(
    repo_root=os.path.abspath('../..'),
    # The namespace the deployer watches for kubeconfig secrets and writes its
    # admin CRs into. Must equal the operator's --provider-namespace (its
    # default) and the namespace config/dev pins onto the etcd base.
    namespace=NAMESPACE,
    # Shared with dex so every hostname in the environment resolves the same way
    # (see ADDRESSING above).
    cluster_id=CLUSTER_ID,
    gateway_nodeport=GATEWAY_NODEPORT,
    # The SAME dict dex is configured from. The shards check tokens against this
    # issuer URL, so a literal here instead of the shared value is a token kcp
    # rejects for reasons nothing logs.
    oidc=KCP_OIDC,
    # The installation's name. It prefixes the engage Secret
    # (`<name>--<clusterID>`) and every generated shard, so changing it renames
    # the whole tree rather than adding a second one.
    platform_mesh_name=os.getenv('PLATFORM_MESH_NAME', 'dev'),
    # Paths on the front proxy for components this environment installs by Helm,
    # accumulated above. Declared with the PlatformMesh because the front proxy is
    # compiled from it — the mapping has to exist before the backing Service does,
    # and a path pointing at an absent backend is a 503 on that path alone rather
    # than a broken proxy.
    front_proxy_mappings=FRONT_PROXY_MAPPINGS,
    # Passed in so the build's relative paths keep resolving against this
    # directory rather than the component's.
    component_binary=component_binary,
    resource_deps=['namespace'],
)
