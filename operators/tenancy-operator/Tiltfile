# Tilt wiring for the tenancy component, living beside the code it
# deploys rather than in contrib/tilt. The root Tiltfile loads deploy_tenancy()
# and calls it when the `tenancy` profile is on.
#
# Everything this component needs is here: the chart (which carries the installer
# as an init container), and the two things that MUST agree with the outside world
# — the install root and the hostAliases — which the caller passes in rather than
# this file guessing.

LABEL = 'tenancy'


def deploy_tenancy(
        repo_root,
        namespace,
        install_root,
        component_build,
        oidc={},
        gateway={},
        platform_mesh_name='dev',
        resource_deps=[]):
    """Deploy the tenancy tree into kcp and the operator that reconciles it.

    Installs into the kcp that platform-mesh-deployer BUILT, not a static one.

    The install genuinely needs kcp admin — creating workspaces, APIExports,
    WorkspaceTypes and the install-time APIBindings does. Running it as a Job
    means the credential leaves when that pod exits; the manager reaches the
    fleet only through APIExport virtual workspaces, bounded by the permission
    claims on them.

    Args:
      repo_root:    absolute path to the monorepo root.
      install_root: the kcp workspace the tree is rooted at. Reaches both the init
                    Job and the manager as one --paths-root, because the two
                    disagreeing means the operator comes up healthy and watches a
                    tree that does not exist.
      oidc:         the SAME settings handed to deploy_deployer. The virtual
                    workspace verifies tokens itself, so it and kcp must agree on
                    issuer, audience and username convention or a caller kcp
                    accepts is rejected here.
      platform_mesh_name: which installation to install into. Used to SELECT the
                    front proxy at runtime, not to name anything.
      component_build: passed in rather than loaded here so the build's relative
                    paths keep resolving against contrib/tilt.

    NO hostalias_ip/hostnames/internal_server. They existed because
    *.pm.localhost resolved to loopback inside a pod, so kcp's advertised
    addresses had to be aliased and its API address overridden. Under sslip.io
    the addresses kcp publishes in its kubeconfigs and endpoint slices resolve
    and route in-cluster unchanged, so the operator dials them verbatim.
    """

    # `tenancy-operator init` installs the tree. The chart can run it either as an
    # init container (production: ordering is a property of the pod) or as a Job.
    #
    # Here it is a JOB, so it becomes its own Tilt resource — with its own logs,
    # its own completion status, and its own trigger button. An init container's
    # output is buried in a pod that then becomes the manager, which makes "did the
    # install work?" and "is the manager healthy?" the same red dot; as a Job they
    # are two, and the install can be re-run without bouncing the operator.
    #
    # The Job name is pinned (jobNameSuffix) rather than hashed: a dev loop
    # rebuilds the image constantly, and a hashed name would mean a new Tilt
    # resource every build. Tilt recreates the Job when its spec changes.
    #
    # Two names, and they are not interchangeable: INIT_JOB is the Kubernetes
    # object the chart renders, INIT_RESOURCE is what the Tilt resource is renamed
    # to. A resource_deps entry naming the object rather than the resource is
    # silently dropped, which is how the manager ended up not waiting for the
    # install at all.
    INIT_JOB = 'tenancy-operator-init-dev'
    INIT_RESOURCE = 'tenancy-init'

    # The Secret the chart mounts as kcp admin. WE choose the name — a Kubeconfig
    # CR names its own output Secret — which is the whole trick that keeps this
    # resolvable at Tiltfile-evaluation time.
    #
    # The front proxy it is minted against is called something like
    # `dev-fp-0fdfeb`: names.FrontProxy() hashes the PlatformMesh, the front proxy
    # and the cluster ID into it, so it cannot be written down here and cannot be
    # waited for either — a local() that blocked until the front proxy existed
    # would deadlock, because evaluating this Tiltfile is what deploys the
    # deployer that creates it. Pinning the Secret name and discovering the front
    # proxy inside a resource that runs LATER is what breaks that cycle.
    KCP_KUBECONFIG_SECRET = 'tenancy-kcp-kubeconfig'
    KCP_RESOURCE = 'tenancy-kcp-credential'

    # Only the values that MUST agree with something outside the chart are set
    # here, and each comes from the same variable the other side uses.
    helm_set = [
        'paths.root=' + install_root,
        # TWO values, not one. The manager reads `kcp.kubeconfigSecretName` and the
        # installer reads `init.kcpAdminSecretName`, and they are separate because
        # in production they SHOULD be: the installer needs kcp admin, the manager
        # needs only enough to resolve APIExportEndpointSlices. Setting one and
        # leaving the other on its `kcp-frontproxy-kubeconfig` default is a Job
        # stuck in ContainerCreating on a Secret that no longer exists — which is
        # exactly what happened here, because the operator came up fine and only
        # the install hung.
        'kcp.kubeconfigSecretName=' + KCP_KUBECONFIG_SECRET,
        'init.kcpAdminSecretName=' + KCP_KUBECONFIG_SECRET,
        # EMPTY on purpose — "use the kubeconfig as-is".
        #
        # These exist to redirect a client away from kcp's public hostname when
        # that hostname resolves, in-cluster, to an address that is advertised but
        # not routed. kcp is addressed over sslip.io here, which resolves to the
        # node and routes from inside the cluster as well as outside, so the
        # address in the kubeconfig is already the right one. Setting them would
        # override a working address with a guess at a Service name that carries a
        # hash.
        'kcp.server=',
        'kcp.serverName=',
        'init.mode=job',
        'init.jobNameSuffix=dev',

        # The tenancy VW, serving `users` self-provision.
        'virtualWorkspace.enabled=true',
        # Exposed by SNI on the shared passthrough listener, exactly like kcp and
        # the IdP — so `tenancyctl --server https://<hostname>:31443` works from
        # the host with no port-forward and no special case.
        'virtualWorkspace.gatewayApi.enabled=' + ('true' if gateway.get('name') else 'false'),
        'virtualWorkspace.gatewayApi.name=' + gateway.get('name', ''),
        'virtualWorkspace.gatewayApi.namespace=' + gateway.get('namespace', ''),
        'virtualWorkspace.gatewayApi.hostname=' + gateway.get('hostname', ''),
        'virtualWorkspace.oidc.issuerURL=' + oidc.get('issuerURL', ''),
        'virtualWorkspace.oidc.clientID=' + oidc.get('clientID', ''),
        'virtualWorkspace.oidc.caSecretName=' + oidc.get('caFileRef', {}).get('name', ''),
        'virtualWorkspace.oidc.caSecretKey=' + oidc.get('caFileRef', {}).get('key', 'ca.crt'),
        'oidc.usernameClaim=' + oidc.get('usernameClaim', 'email'),
        # Read from the same dict kcp is configured from, so the operator's mirror
        # of kcp's username convention cannot drift from kcp's actual one.
        'oidc.usernamePrefix=' + oidc.get('usernamePrefix', ''),
        # Word-pair names in dev, UUIDs in production. A workspace you have to
        # read out of a log, paste into a kubeconfig or say out loud is the whole
        # inner loop here, and `amber-harbor` survives that where a UUID does not.
        # Override with TENANCY_NAMING_STRATEGY to exercise another one.
        'tenancy.namingStrategy=' + os.getenv('TENANCY_NAMING_STRATEGY', 'words'),

        # Dev kcp is single-replica and there is no kube client for a lock.
        'leaderElect=false',
        'log.level=debug',
    ]

    # The kcp admin credential, minted by kcp-operator rather than borrowed.
    #
    # A Kubeconfig CR names a front proxy, a user and groups; the operator issues
    # the client certificate and writes a ready-to-use kubeconfig into the Secret
    # this names. The front proxy is selected by the labels the deployer stamps on
    # everything it generates, which are the only stable handle on a name that
    # carries a hash.
    #
    # Runs before the install Job and the manager, both of which mount the Secret.
    local_resource(
        KCP_RESOURCE,
        cmd='''set -eo pipefail
NS={ns}
PM={pm}

echo "waiting for the front proxy of PlatformMesh $PM..."
until FP=$(kubectl -n "$NS" get frontproxies.operator.kcp.io \\
      -l deploy.platform-mesh.io/platform-mesh="$PM",deploy.platform-mesh.io/component=frontproxy \\
      -o jsonpath='{{.items[0].metadata.name}}' 2>/dev/null) && [ -n "$FP" ]; do
  sleep 2
done
echo "front proxy: $FP"

kubectl apply -f - <<EOF
apiVersion: operator.kcp.io/v1alpha1
kind: Kubeconfig
metadata:
  name: tenancy-operator
  namespace: $NS
spec:
  target:
    frontProxyRef:
      name: $FP
  targetWorkspace: root
  username: tenancy-operator
  groups:
    - system:kcp:admin
  validity: 720h
  secretRef:
    name: {secret}
EOF

kubectl -n "$NS" wait kubeconfig/tenancy-operator --for=condition=Available --timeout=5m
kubectl -n "$NS" wait "secret/{secret}" --for=create --timeout=5m'''.format(
            ns=namespace, pm=platform_mesh_name, secret=KCP_KUBECONFIG_SECRET),
        resource_deps=resource_deps,
        labels=[LABEL],
        allow_parallel=True,
    )

    component_build(
        name='tenancy-operator',
        path='operators/tenancy-operator',
        deps=['apis', 'subroutines', 'golang-commons'],
        # Must match what the chart renders, so Tilt substitutes the locally-built
        # image (it swaps by repository, keeping the chart's args).
        image='ghcr.io/platform-mesh/platform-mesh/tenancy-operator',
        # The production chart, not a local-only manifest: what Tilt renders here
        # is what a real install renders.
        chart=os.path.join(repo_root, 'operators/tenancy-operator/deploy/helm/tenancy-operator'),
        namespace=namespace,
        helm_set=helm_set,
        # The manager waits for the install, exactly as the init container ordering
        # would have guaranteed — just observable. Depends on the RESOURCE name,
        # not the Job's object name.
        resource_deps=[INIT_RESOURCE],
        labels=[LABEL],
    )

    # The virtual workspace: its own resource, because "is the API serving?" and
    # "is the controller reconciling?" are different questions with different
    # answers, and one red dot for both hides which.
    k8s_resource(
        'tenancy-operator-vw',
        new_name='tenancy-vw',
        objects=['tenancy-operator-vw:certificate', 'tenancy-operator-vw:tlsroute'],
        resource_deps=[INIT_RESOURCE],
        labels=[LABEL],
    )

    # The installer's own resource. Named after the Job the chart renders; Tilt
    # discovers it from the same k8s_yaml the chart produced.
    k8s_resource(
        INIT_JOB,
        new_name=INIT_RESOURCE,
        # The ServiceAccount rides with THIS resource, not the operator's.
        # Both pods use it, and this one runs first — leaving it on the operator
        # (which now waits for this Job) means the Job cannot schedule until the
        # operator deploys, and the operator will not deploy until the Job
        # finishes. Tilt reports that deadlock as an unhelpful
        # `serviceaccount "tenancy-operator" not found` on the Job.
        objects=['tenancy-operator:serviceaccount'],
        # Waits for the credential, not just the namespace: the Job mounts the
        # Secret the Kubeconfig CR produces, and a pod whose Secret does not exist
        # yet sits in ContainerCreating rather than failing with something that
        # names the missing object.
        resource_deps=resource_deps + [KCP_RESOURCE],
        labels=[LABEL],
    )
