# Tilt wiring for the platform-mesh-deployer, living beside the code and the
# kustomizations it deploys. The root Tiltfile loads deploy_deployer() and calls
# it unconditionally: this component IS the environment's kcp.
#
# The deployer's whole job is to build kcp — it compiles a PlatformMesh into
# RootShard / Shard / FrontProxy admin CRs and then, running kcp-operator's own
# controller groups in-process, into Deployments. It is the only source of kcp in
# this environment: anything else writing those CRs would own the same shards, as
# would a separately deployed kcp-operator.
#
# Shape mirrors test/e2e TestSingleCluster: one cluster acting as its own config
# plane and workload cluster, addressed over sslip.io so the hostnames kcp
# advertises resolve from inside the cluster as well as out.

LABEL = 'deployer'

# CoreDNS in kind forwards to the host resolver, and many of those drop answers
# that point at private IPs (DNS rebinding protection) — which is exactly what
# sslip.io returns here. Without this, in-cluster lookups of
# <name>.<dashed-ip>.sslip.io fail and every shard-to-shard and shard-to-etcd
# dial fails with "no such host". The template block answers them locally.
COREDNS_SSLIP_BLOCK = '''sslip.io:53 {
    errors
    template IN A sslip.io {
        match "[.-](?P<a>[0-9]{1,3})-(?P<b>[0-9]{1,3})-(?P<c>[0-9]{1,3})-(?P<d>[0-9]{1,3})[.]sslip[.]io[.]$"
        answer "{{ .Name }} 60 IN A {{ .Group.a }}.{{ .Group.b }}.{{ .Group.c }}.{{ .Group.d }}"
        fallthrough
    }
}
'''


def deploy_deployer(
        repo_root,
        namespace,
        cluster_id,
        gateway_nodeport,
        component_binary,
        oidc={},
        platform_mesh_name='dev',
        front_proxy_mappings=[],
        resource_deps=[]):
    """Deploy the platform-mesh-deployer and a dev PlatformMesh for it to build.

    Args:
      repo_root:    absolute path to the monorepo root. Paths inside a
                    load_dynamic'd Tiltfile resolve against the CALLER's
                    directory (contrib/tilt), not this one, so every path below
                    is joined onto this rather than written relative.
      namespace:    the provider namespace — where the deployer watches for
                    kubeconfig secrets (--provider-namespace) and writes its
                    admin CRs. Must match config/dev's overlay namespace.
      cluster_id:   the ID this cluster is engaged under, and the middle label of
                    every hostname below. Must be (a) a legal DNS label and (b)
                    the node's dashed IP, so `root.<id>.sslip.io` resolves back to
                    the node. Passed in rather than resolved here because dex is
                    addressed the same way and is configured before kcp exists.
      gateway_nodeport: the port every hostname is served on. It has to be a
                    NodePort, not the gateway's own listener port: sslip.io
                    resolves to the NODE, and nothing listens on node:8443. A
                    shard that advertises a port the node does not serve comes up
                    healthy and is unreachable.
      oidc:         the SAME dict dex is configured from. The shards verify tokens
                    against this issuer URL, so a value that merely looks right is
                    a token kcp rejects with nothing useful in the log.
      component_binary: passed in rather than loaded here, for the same reason as
                    repo_root: the build's ./bin and ./runtime.Dockerfile are
                    relative to contrib/tilt.
      front_proxy_mappings: paths the front proxy serves in ADDITION to kcp's own,
                    as [{'path': ..., 'backend': ...}]. Rendered into a
                    FrontProxyTemplate the PlatformMesh references.

                    This exists for components installed by Helm rather than by an
                    OCMModule. A module declares its own path with a component
                    `mapping` and the deployer registers it; a chart cannot, and
                    not for want of a field — the deployer rebuilds
                    spec.additionalPathMappings from the template plus every
                    module and server-side-applies it with ForceOwnership, so
                    anything a chart wrote there is erased on the next reconcile.
                    The template is the one seam a non-module component can use.
      resource_deps: prerequisites for the leaf resources (e.g. the namespace).
    """

    cfg = lambda *p: os.path.join(repo_root, 'operators/platform-mesh-deployer/config', *p)

    def sslip(name):
        return '{}.{}.sslip.io'.format(name, cluster_id)

    # ---------------------------------------------------------------------
    # prerequisites the deployer compiles against
    # ---------------------------------------------------------------------

    # The self-signed ClusterIssuer named `kcp`, which the RootShardTemplate's
    # certificates.issuerRef points at. Named distinctly from the base env's
    # `cert-issuer` resource (a namespaced Issuer called `selfsigned`) — these are
    # two different objects and collapsing them into one Tilt resource name would
    # make "which issuer failed?" unanswerable.
    k8s_yaml(cfg('bases', 'cert-issuer', 'clusterissuer.yaml'))
    k8s_resource(
        new_name='deployer-cert-issuer',
        objects=['kcp:clusterissuer'],
        labels=[LABEL],
    )

    # A writable OCI registry, so a module component can be built from this
    # checkout and resolved by the deployer without leaving the machine.
    #
    # Without it the only component an OCMModule can name is a PUBLISHED one, and
    # every change to a payload — the chart, values.module*.yaml — is invisible
    # until it is released. The gap does not announce itself: the deployer happily
    # applies the last published payload, so a fix that is in the working tree and
    # a fix that is deployed look identical from the cluster.
    #
    # Plain HTTP, reached at registry.<namespace>.svc:5000 in-cluster and on the
    # node's :30500 from the host. The deployer's resolver takes an http:// URL
    # and turns off TLS for it (pkg/ocm.ParseRepositoryURL); the node never pulls
    # from here, because a locally built IMAGE is side-loaded with `kind load`
    # under a tag no registry serves — see `task dev-module`.
    # The namespace is stamped here rather than in the base, which carries none
    # because e2e applies it into a namespace of its own choosing. Without this
    # the objects land in `default`, and the failure is not where you would look:
    # the NodePort still accepts a push, because a NodePort belongs to no
    # namespace, so publishing a component SUCCEEDS and only the deployer fails —
    # resolving registry.<namespace>.svc, which now names a Service that is not
    # there.
    _registry = []
    for o in decode_yaml_stream(kustomize(cfg('bases', 'registry'))):
        o['metadata']['namespace'] = namespace
        _registry.append(o)
    k8s_yaml(encode_yaml_stream(_registry))
    k8s_resource(
        'registry',
        new_name='deployer-registry',
        labels=[LABEL],
        resource_deps=resource_deps,
    )

    # The `eg` gateway the PlatformMesh's ingress stack attaches to, plus the
    # NodePort that makes it reachable at the sslip.io addresses.
    #
    # The environment's ONLY gateway: dex hangs its TLSRoute off it too, as does
    # anything else that needs one. It has no `hostnames` restriction, which is
    # what lets one listener carry `fp.<id>.sslip.io`, `idp.<id>.sslip.io` and
    # whatever else appears at once — a listener and a route whose hostnames do
    # not intersect simply never attach, with no error on either object.
    k8s_yaml(cfg('bases', 'envoy-gateway', 'gateway.yaml'))
    k8s_resource(
        new_name='deployer-gateway',
        objects=[
            'eg:gatewayclass',
            'eg:gateway',
            'eg-nodeport:service',
        ],
        labels=[LABEL],
    )

    # CoreDNS. Its own resource rather than a step folded into another, because
    # it is the single most likely thing to be silently missing on a cluster that
    # was not created by this Tiltfile, and a failure here surfaces later as
    # unrelated-looking connection errors in kcp.
    local_resource(
        'deployer-dns',
        cmd='''set -eo pipefail
if kubectl -n kube-system get configmap coredns -o jsonpath='{.data.Corefile}' | grep -q 'sslip.io'; then
  echo "coredns already answers sslip.io"
  exit 0
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cat > "$tmp/Corefile" <<'SSLIP_EOF'
''' + COREDNS_SSLIP_BLOCK + '''SSLIP_EOF
kubectl -n kube-system get configmap coredns -o jsonpath='{.data.Corefile}' >> "$tmp/Corefile"
kubectl -n kube-system create configmap coredns --from-file=Corefile="$tmp/Corefile" --dry-run=client -o yaml | kubectl apply -f -
kubectl -n kube-system rollout restart deployment/coredns
kubectl -n kube-system rollout status deployment/coredns --timeout=180s''',
        labels=[LABEL],
        allow_parallel=True,
    )

    # kcp-operator's CRDs, without kcp-operator.
    #
    # The deployer runs both of kcp-operator's controller groups in its own
    # process, so there is no operator Deployment to install them — but the
    # deployer still writes operator.kcp.io admin CRs and reconciles the
    # deploy.operator.kcp.io compiled ones, so the schemas have to be here.
    #
    # kubectl -k, not Tilt's kustomize(): the base is a remote GitHub URL and the
    # builtin does not fetch those.
    local_resource(
        'kcp-operator-crds',
        cmd='kubectl apply --server-side --force-conflicts -k ' + cfg('bases', 'kcp-operator', 'crds'),
        labels=[LABEL],
        allow_parallel=True,
    )

    # etcd, with mutual TLS — the shards' backing store.
    #
    # Reachable over the gateway at etcd.<cluster>.sslip.io rather than only at
    # etcd.<ns>.svc, because a shard scheduled onto another cluster resolves the
    # advertised endpoint verbatim and a .svc name means nothing there. Single
    # cluster today; addressing it this way is what keeps the multi-cluster case
    # from being a different manifest.
    k8s_yaml(kustomize(cfg('dev')))

    # The server certificate and the route carry the cluster ID, so they are
    # generated here rather than checked in — same two objects test/e2e templates
    # at runtime, for the same reason.
    k8s_yaml(blob('''apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: etcd-server
  namespace: {ns}
spec:
  secretName: etcd-server-tls
  dnsNames:
    - etcd
    - etcd.{ns}.svc
    - etcd.{cluster}.sslip.io
  usages:
    - server auth
  privateKey:
    algorithm: ECDSA
    size: 256
  issuerRef:
    name: etcd-ca
    kind: Issuer
    group: cert-manager.io
---
apiVersion: gateway.networking.k8s.io/v1alpha2
kind: TLSRoute
metadata:
  name: etcd
  namespace: {ns}
spec:
  parentRefs:
    - name: eg
      namespace: envoy-gateway-system
      sectionName: passthrough
  hostnames:
    - etcd.{cluster}.sslip.io
  rules:
    - backendRefs:
        - name: etcd
          port: 2379
'''.format(ns=namespace, cluster=cluster_id)))

    k8s_resource(
        'etcd',
        new_name='deployer-etcd',
        objects=[
            'etcd-ca:certificate',
            'etcd-ca:issuer',
            'etcd-client:certificate',
            'etcd-server:certificate',
            'etcd:tlsroute',
        ],
        resource_deps=resource_deps + ['deployer-cert-issuer', 'deployer-gateway'],
        labels=[LABEL],
    )

    # ---------------------------------------------------------------------
    # the operator itself
    # ---------------------------------------------------------------------

    component_binary(
        name='platform-mesh-deployer',
        path='operators/platform-mesh-deployer',
        deps=['apis', 'golang-commons', 'subroutines'],
        # Must match what config/default's image transformer renders, so Tilt
        # substitutes the locally-built image (it swaps by repository).
        image='ghcr.io/platform-mesh/platform-mesh/platform-mesh-deployer',
        labels=[LABEL],
    )

    # config/default is the real install — CRDs, RBAC and the manager — so what
    # runs here is what a `kubectl apply -k config/default` gets, minus two
    # dev-only edits made on the rendered objects rather than by forking the
    # kustomization into a Tilt-only overlay:
    #
    #   - the Namespace is dropped. The base env already applies
    #     platform-mesh-system as its own Tilt resource, and the same object
    #     arriving from two k8s_yaml() calls is a duplicate Tilt refuses to load.
    #   - --log-level=debug is appended. This profile's failure mode is a
    #     reconcile that quietly produces nothing, and at info level there is
    #     nothing in the log to say why.
    objs = []
    for o in decode_yaml_stream(kustomize(cfg('default'))):
        if o['kind'] == 'Namespace':
            continue
        if o['kind'] == 'Deployment':
            o['spec']['template']['spec']['containers'][0]['args'].append('--log-level=debug')
        objs.append(o)
    k8s_yaml(encode_yaml_stream(objs))

    # The CRDs get their OWN resource, separate from the operator.
    #
    # This is not tidiness, it is damage control. Tilt DELETES and recreates a
    # resource's objects on a forced update — the trigger button — and deleting a
    # CRD deletes every CR of that type with it. `platformmeshes` going away takes
    # the PlatformMesh, and the ownerReferences the deployer stamps on what it
    # generates (controller: true, blockOwnerDeletion: true) cascade that into
    # every RootShard, Shard and FrontProxy and their Deployments.
    #
    # With the CRDs folded into the operator's resource, "restart the operator" —
    # the single most common gesture in this profile — silently destroyed the
    # whole kcp installation. Split out, triggering the operator restarts a pod
    # and nothing else.
    #
    # Triggering THIS resource still cascades. That is inherent to deleting a CRD
    # and is why it is worth having as its own line in the UI you have to aim at
    # deliberately, rather than a side effect of restarting a workload.
    k8s_resource(
        new_name='deployer-crds',
        objects=[
            'cacheservertemplates.deploy.platform-mesh.io:customresourcedefinition',
            'frontproxytemplates.deploy.platform-mesh.io:customresourcedefinition',
            'ocmmodules.deploy.platform-mesh.io:customresourcedefinition',
            'ocmmodulesetups.deploy.platform-mesh.io:customresourcedefinition',
            'platformmeshes.deploy.platform-mesh.io:customresourcedefinition',
            'rootshardtemplates.deploy.platform-mesh.io:customresourcedefinition',
            'shardtemplates.deploy.platform-mesh.io:customresourcedefinition',
            'virtualworkspacetemplates.deploy.platform-mesh.io:customresourcedefinition',
        ],
        labels=[LABEL],
    )

    k8s_resource(
        'platform-mesh-deployer-controller-manager',
        new_name='platform-mesh-deployer',
        # RBAC only. These are safe to delete and recreate: nothing owns them and
        # nothing is garbage-collected behind them. Folded in here rather than
        # left to Tilt's dependency-less "uncategorized" catch-all, which would
        # apply them before the namespace exists.
        objects=[
            'platform-mesh-deployer-controller-manager:serviceaccount',
            'platform-mesh-deployer-leader-election-role:role',
            'platform-mesh-deployer-leader-election-rolebinding:rolebinding',
            'platform-mesh-deployer-manager-role:clusterrole',
            'platform-mesh-deployer-manager-rolebinding:clusterrolebinding',
        ],
        resource_deps=resource_deps + ['kcp-operator-crds', 'deployer-crds'],
        labels=[LABEL],
    )

    # ---------------------------------------------------------------------
    # engaging this cluster as its own workload cluster
    # ---------------------------------------------------------------------

    # The deployer reaches every workload cluster through a kubeconfig Secret —
    # there is no "and also myself" special case, so the single-cluster setup has
    # to hand it a kubeconfig pointing back at the cluster it is already running
    # in. The label KEYS are the selector (one provider per component); the values
    # are ignored. The name is load-bearing: everything before `--` is the
    # PlatformMesh it belongs to and everything after is the cluster ID that lands
    # in `cluster` in the CEL templates below.
    #
    # A ServiceAccount token rather than the admin credential, and
    # insecure-skip-tls-verify rather than plumbing the cluster CA: the pod dials
    # kubernetes.default.svc, whose serving cert is signed by the cluster CA that
    # this kubeconfig would have to carry. Skipping verification on an in-cluster
    # dial to a kind cluster costs nothing real and removes the most common way
    # this resource fails to produce a usable credential.
    local_resource(
        'deployer-engage',
        cmd='''set -eo pipefail
NS={ns}
SA=platform-mesh-deployer-workload
SECRET={pm}--{cluster}

kubectl -n "$NS" create serviceaccount "$SA" --dry-run=client -o yaml | kubectl apply -f -
kubectl create clusterrolebinding "$SA" \\
  --clusterrole=cluster-admin --serviceaccount="$NS:$SA" \\
  --dry-run=client -o yaml | kubectl apply -f -

TOKEN=$(kubectl -n "$NS" create token "$SA" --duration=8760h)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cat > "$tmp/kubeconfig" <<EOF
apiVersion: v1
kind: Config
current-context: default
clusters:
  - name: default
    cluster:
      server: https://kubernetes.default.svc
      insecure-skip-tls-verify: true
users:
  - name: default
    user:
      token: $TOKEN
contexts:
  - name: default
    context:
      cluster: default
      user: default
EOF

kubectl -n "$NS" create secret generic "$SECRET" \\
  --from-file=kubeconfig="$tmp/kubeconfig" --dry-run=client -o yaml \\
  | kubectl label --local -f - -o yaml \\
      deploy.platform-mesh.io/rootshard=true \\
      deploy.platform-mesh.io/frontproxy=true \\
      deploy.platform-mesh.io/shards-default=true \\
  | kubectl apply -f -'''.format(ns=namespace, pm=platform_mesh_name, cluster=cluster_id),
        resource_deps=resource_deps,
        labels=[LABEL],
        allow_parallel=True,
    )

    # ---------------------------------------------------------------------
    # the installation to build
    # ---------------------------------------------------------------------

    # The OIDC block the root shard authenticates against, rendered from the SAME
    # dict dex is configured from so the issuer the shards verify against and the
    # issuer dex advertises cannot drift. Indented to sit under `spec.auth` in the
    # RootShardTemplate below.
    #
    # Without it kcp has no external authenticator at all: the only identities
    # are the operator's own certificates, so every human is anonymous and every
    # RBAC binding for a person names a subject that can never authenticate.
    _oidc_block = ''
    if oidc.get('issuerURL') and oidc.get('clientID'):
        _oidc_block = '\n'.join([
            '  auth:',
            '    oidc:',
            '      issuerURL: ' + oidc['issuerURL'],
            '      clientID: ' + oidc['clientID'],
            '      usernameClaim: ' + oidc.get('usernameClaim', 'email'),
            '      usernamePrefix: "' + oidc.get('usernamePrefix', '') + '"',
            '      groupsClaim: ' + oidc.get('groupsClaim', 'groups'),
            # Rendered ALWAYS, and never allowed to fall through to kcp's own
            # default, which is `oidc:` rather than empty. Anything writing RBAC
            # for an IdP group mirrors this pair to decide what a caller's groups
            # are called; a prefix that only one side applies splits every group
            # in two and admits the holder on one plane while denying them on the
            # other.
            '      groupsPrefix: "' + oidc.get('groupsPrefix', '') + '"',
            '      caFileRef:',
            '        name: ' + oidc.get('caFileRef', {}).get('name', 'dex-ca'),
            '        key: ' + oidc.get('caFileRef', {}).get('key', 'ca.crt'),
        ])

    # A FrontProxyTemplate, only when something asked for a path on the front
    # proxy. Rendered here rather than by the caller because the PlatformMesh has
    # to reference it, and the two would otherwise be edited in two files.
    #
    # The three certificate paths are the front proxy's own mounts, and are the
    # same values the deployer writes for a module's mapping (frontproxy.go). A
    # mapping without them is served without client identity, so the backend sees
    # every caller as anonymous.
    _fp_template = ''
    _fp_template_ref = ''
    if front_proxy_mappings:
        _entries = ''.join([('''
    - path: {path}
      backend: {backend}
      backend_server_ca: /etc/kcp/tls/ca/tls.crt
      proxy_client_cert: /etc/kcp-front-proxy/requestheader-client/tls.crt
      proxy_client_key: /etc/kcp-front-proxy/requestheader-client/tls.key''').format(**m)
            for m in front_proxy_mappings])
        _fp_template = '''apiVersion: deploy.platform-mesh.io/v1alpha1
kind: FrontProxyTemplate
metadata:
  name: fp
  namespace: {ns}
spec:
  additionalPathMappings:{entries}
---
'''.format(ns=namespace, entries=_entries)
        _fp_template_ref = '''
      templateRef:
        name: fp'''

    # A dev PlatformMesh and the two topology templates it references, mirroring
    # test/e2e's fixture. The quoting is not a typo: hostnameTemplate, the etcd
    # endpoints and the etcd prefix are CEL EXPRESSIONS, so a literal string has
    # to appear as a quoted string inside the YAML string. `platformMesh`,
    # `component` and `cluster` are the variables the deployer binds per shard.
    #
    # `external`, `cache` and `rootShard` are placeholders. A template carries the
    # same spec type as the object it is merged onto, so the schema requires them,
    # but the deployer overwrites all three from the clusters it engaged.
    k8s_yaml(blob(_fp_template + '''apiVersion: deploy.platform-mesh.io/v1alpha1
kind: RootShardTemplate
metadata:
  name: root
  namespace: {ns}
spec:
  external:
    hostname: overwritten
    port: 1
  cache: {{}}
  etcd:
    endpoints:
      - '"https://etcd.{cluster}.sslip.io:{port}"'
    prefix: '"/" + platformMesh + "/root"'
    tlsConfig:
      secretRef:
        name: etcd-client-tls
  certificates:
    issuerRef:
      name: kcp
      kind: ClusterIssuer
      group: cert-manager.io
{oidc}
---
apiVersion: deploy.platform-mesh.io/v1alpha1
kind: ShardTemplate
metadata:
  name: default
  namespace: {ns}
spec:
  rootShard:
    reference:
      name: overwritten
  etcd:
    endpoints:
      - '"https://etcd.{cluster}.sslip.io:{port}"'
    prefix: '"/" + platformMesh + "/" + component + "/" + cluster'
    tlsConfig:
      secretRef:
        name: etcd-client-tls
---
apiVersion: deploy.platform-mesh.io/v1alpha1
kind: PlatformMesh
metadata:
  name: {pm}
  namespace: {ns}
spec:
  version: "0.0.0"
  ocm:
    # Never resolved in this profile: no OCMModule references it, and the
    # topology half of the deployer does not consult OCM at all. Point it at a
    # real repository when working on the module controllers.
    url: oci://example.com/platform-mesh
  ingress:
    - name: gateway
      type: gatewayapi
      gatewayAPI:
        gatewayName: eg
        gatewayNamespace: envoy-gateway-system
        sectionName: passthrough
  topology:
    rootShard:
      name: root
      templateRef:
        name: root
      exposure:
        hostnameTemplate: '"root." + cluster + ".sslip.io"'
        port: {port}
      virtualWorkspaces:
        exposure:
          hostnameTemplate: '"vw-root." + cluster + ".sslip.io"'
          port: {port}
    shardGroups:
      - name: default
        templateRef:
          name: default
        exposure:
          hostnameTemplate: 'component + "." + cluster + ".sslip.io"'
          port: {port}
        virtualWorkspaces:
          exposure:
            hostnameTemplate: '"vw." + component + "." + cluster + ".sslip.io"'
            port: {port}
    frontProxy:
      name: fp{fp_ref}
      exposure:
        hostnameTemplate: '"fp." + cluster + ".sslip.io"'
        port: {port}
'''.format(ns=namespace, pm=platform_mesh_name, cluster=cluster_id, port=gateway_nodeport,
           oidc=_oidc_block, fp_ref=_fp_template_ref)))

    k8s_resource(
        new_name='platformmesh',
        objects=[
            '{}:platformmesh'.format(platform_mesh_name),
            'root:rootshardtemplate',
            'default:shardtemplate',
        ] + (['fp:frontproxytemplate'] if front_proxy_mappings else []),
        # Everything the reconcile touches on its first pass. The engage Secret
        # especially: without it the deployer has no cluster to place shards on
        # and the PlatformMesh sits unreconciled with no error to point at.
        #
        # Forcing THIS resource deletes the PlatformMesh and takes the generated
        # kcp down with it, by the same ownerReference cascade described at
        # deployer-crds. That one is at least honest — you asked to redeploy the
        # installation — but it is not a restart.
        resource_deps=[
            'platform-mesh-deployer',
            'deployer-etcd',
            'deployer-dns',
            'deployer-engage',
        ],
        labels=[LABEL],
    )

    # ---------------------------------------------------------------------
    # an admin kubeconfig to poke the result with
    # ---------------------------------------------------------------------

    # kcp-operator already mints client credentials on request — a Kubeconfig CR names a
    # front proxy, a user and groups, and the operator issues the cert and writes
    # a ready-to-use kubeconfig into a Secret. This asks for one and dumps it to
    # disk.
    #
    # A SEPARATE credential rather than reusing the `<name>-provisioner` Kubeconfig
    # the deployer makes for itself. That one is the operator's identity; borrowing
    # it means anything you do by hand is indistinguishable from the controller's
    # own writes in an audit log, and revoking or expiring it to clean up after
    # yourself breaks the running operator.
    #
    # Built by a script rather than checked in as YAML because the front proxy's
    # name is generated — `names.FrontProxy()` hashes the PlatformMesh, the front
    # proxy and the cluster ID into it (dev-fp-0fdfeb), so it cannot be written
    # down ahead of time. The labels the deployer stamps on every generated CR are
    # the stable handle, so the script selects on those.
    local_resource(
        'deployer-admin',
        cmd='''set -eo pipefail
NS={ns}
PM={pm}
DIR="${{KCP_KUBECONFIG_DIR:-.secret/kcp}}"
mkdir -p "$DIR"

echo "waiting for the front proxy of PlatformMesh $PM..."
until FP=$(kubectl -n "$NS" get frontproxies.operator.kcp.io \\
      -l deploy.platform-mesh.io/platform-mesh="$PM",deploy.platform-mesh.io/component=frontproxy \\
      -o jsonpath='{{.items[0].metadata.name}}' 2>/dev/null) && [ -n "$FP" ]; do
  sleep 2
done
echo "front proxy: $FP"

kubectl apply -f - <<EOF
apiVersion: operator.kcp.io/v1alpha1
kind: Kubeconfig
metadata:
  name: $PM-admin
  namespace: $NS
spec:
  target:
    frontProxyRef:
      name: $FP
  targetWorkspace: root
  username: tilt-admin
  groups:
    - system:kcp:admin
  validity: 720h
  secretRef:
    name: $PM-admin-kubeconfig
EOF

kubectl -n "$NS" wait "kubeconfig/$PM-admin" --for=condition=Available --timeout=5m
kubectl -n "$NS" wait "secret/$PM-admin-kubeconfig" --for=create --timeout=5m
kubectl -n "$NS" get "secret/$PM-admin-kubeconfig" -o jsonpath='{{.data.kubeconfig}}' \\
  | base64 -d > "$DIR/tilt-$PM-admin.kubeconfig"

echo
echo "  export KUBECONFIG=contrib/tilt/$DIR/tilt-$PM-admin.kubeconfig"
echo "  kubectl get workspaces"
echo'''.format(ns=namespace, pm=platform_mesh_name),
        # The front proxy only exists once the PlatformMesh has been compiled and
        # its workloads rolled out.
        resource_deps=['platformmesh'],
        labels=[LABEL],
        allow_parallel=True,
    )

    print('kcp: platformMesh={} cluster={} front-proxy=https://{}:{}'.format(
        platform_mesh_name, cluster_id, sslip('fp'), gateway_nodeport))
